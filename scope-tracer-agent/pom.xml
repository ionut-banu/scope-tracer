<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0                              https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ionutbanu</groupId>
    <artifactId>scope-tracer-parent</artifactId>
    <version>0.4.0-SNAPSHOT</version>
  </parent>

  <artifactId>scope-tracer-agent</artifactId>

  <name>scope-tracer-agent</name>
  <description>Java agent that instruments StructuredTaskScope at the bytecode level so any JDK 27+ application is traced without source changes.</description>

  <dependencies>
    <dependency>
      <groupId>com.ionutbanu</groupId>
      <artifactId>scope-tracer-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
    </dependency>

    <dependency>
      <groupId>com.ionutbanu</groupId>
      <artifactId>scope-tracer-analyzer</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Step 1: produce the regular (thin) jar with agent manifest entries -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Premain-Class>com.ionutbanu.scopetracer.agent.ScopeTracerAgent</Premain-Class>
              <Can-Redefine-Classes>true</Can-Redefine-Classes>
              <Can-Retransform-Classes>true</Can-Retransform-Classes>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>

      <!-- Step 2: shade everything into a fat-jar with classifier "agent".
           The fat-jar must also carry the agent manifest entries so the JVM honours
           them when the jar is loaded via -javaagent. We also set Boot-Class-Path
           to the fat-jar filename so the JVM adds it to the bootstrap classloader -
           required for advice code to be visible when instrumenting JDK classes.

           The bootstrap classloader is asked first by every other loader, so any
           third-party package in this jar replaces the application's own copy. SLF4J
           (the analyzer uses it for auto-HTML) and ByteBuddy are therefore relocated
           under com.ionutbanu.scopetracer.shaded; the jar exposes no package outside
           com.ionutbanu.scopetracer. AgentIsolationIT checks this. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>agent</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <relocations>
                <relocation>
                  <pattern>org.slf4j</pattern>
                  <shadedPattern>com.ionutbanu.scopetracer.shaded.org.slf4j</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>net.bytebuddy</pattern>
                  <shadedPattern>com.ionutbanu.scopetracer.shaded.net.bytebuddy</shadedPattern>
                </relocation>
                <!-- SLF4J's system properties (slf4j.provider, slf4j.internal.verbosity, ...)
                     belong to the application's SLF4J. Read by the relocated copy, the
                     application's slf4j.provider names a class the bootstrap loader cannot
                     load, and SLF4J fails with an error on stderr. Shade rewrites only names
                     that look like the relocated packages, so these are renamed explicitly. -->
                <relocation>
                  <pattern>^slf4j\.</pattern>
                  <shadedPattern>com.ionutbanu.scopetracer.shaded.slf4j.</shadedPattern>
                  <rawString>true</rawString>
                </relocation>
              </relocations>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Premain-Class>com.ionutbanu.scopetracer.agent.ScopeTracerAgent</Premain-Class>
                    <Can-Redefine-Classes>true</Can-Redefine-Classes>
                    <Can-Retransform-Classes>true</Can-Retransform-Classes>
                    <Boot-Class-Path>scope-tracer-agent-${project.version}-agent.jar</Boot-Class-Path>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <!-- module descriptors of the bundled jars describe the unrelocated
                         packages; the fat-jar is not a module -->
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>org.slf4j:*</artifact>
                  <excludes>
                    <exclude>META-INF/maven/**</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>net.bytebuddy:*</artifact>
                  <excludes>
                    <exclude>META-INF/maven/**</exclude>
                    <!-- Multi-release classes: Shade does not relocate them, and the fat-jar
                         is not multi-release, so the JVM never loaded them anyway. -->
                    <exclude>META-INF/versions/**</exclude>
                  </excludes>
                </filter>
                <!-- Do not bundle Logback. The relocated SLF4J cannot see the application's
                     binding (it is not even looking for org.slf4j providers), and a bundled
                     binding would print the analyzer's log lines into the application's
                     output. The relocated SLF4J finds only NopSlf4jServiceProvider, from
                     src/main/resources/META-INF/services, and stays silent. -->
                <filter>
                  <artifact>ch.qos.logback:*</artifact>
                  <excludes>
                    <exclude>**</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Step 3: run integration tests after the fat-jar is built.
           The IT forks a child JVM with -javaagent pointing at the fat-jar,
           so it must run in the failsafe (post-package) phase. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <argLine>--enable-preview</argLine>
          <systemPropertyVariables>
            <agentJar>${project.build.directory}/scope-tracer-agent-${project.version}-agent.jar</agentJar>
            <testClassesDir>${project.build.testOutputDirectory}</testClassesDir>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
